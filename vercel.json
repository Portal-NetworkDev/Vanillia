{
  "headers": [
    {
      "source": "/uv/sw.js",
      "headers": [
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/baremux/:path*",
      "destination": "/engines/public/baremux/:path*"
    },
    {
      "source": "/epoxy/:path*",
      "destination": "/engines/public/epoxy/:path*"
    },
    {
      "source": "/libcurl/:path*",
      "destination": "/engines/public/libcurl/:path*"
    },
    {
      "source": "/scram/:path*",
      "destination": "/engines/public/scram/:path*"
    },
    {
      "source": "/uv/:path*",
      "destination": "/engines/public/uv/:path*"
    },
    {
      "source": "/sw.js",
      "destination": "/engines/public/sw.js"
    },
    {
      "source": "/vanillia",
      "destination": "/api/vanillia"
    },
    {
      "source": "/service-worker.js",
      "destination": "/api/vanillia"
    },
    {
      "source": "/favicon",
      "destination": "/api/vanillia"
    },
    {
      "source": "/api/icon",
      "destination": "/api/vanillia"
    },
    {
      "source": "/education",
      "destination": "/api/scramjet"
    },
    {
      "source": "/classroom",
      "destination": "/api/ultraviolet"
    }
  ]
}
